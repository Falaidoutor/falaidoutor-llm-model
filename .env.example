# ──────────────────────────────────────────────────────────────
# Configurações do Qdrant
# ──────────────────────────────────────────────────────────────
QDRANT_URL=https://seu-cluster.sua-regiao.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sintomas_embeddings_v2
QDRANT_CLOUD_INFERENCE=true
QDRANT_INFERENCE_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384

# ──────────────────────────────────────────────────────────────
# Configurações do PostgreSQL
# ──────────────────────────────────────────────────────────────
# Use a URL do Transaction Pooler do Supabase em ambientes serverless.
POSTGRES_DSN=postgresql://usuario:senha@host:6543/postgres?sslmode=require
POSTGRES_POOL_SIZE=2

# ──────────────────────────────────────────────────────────────
# Supabase Data API (não substitui a conexão PostgreSQL acima)
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-publicavel

# ──────────────────────────────────────────────────────────────
# Configurações do E5 Embedding
# ──────────────────────────────────────────────────────────────
# Os embeddings são gerados remotamente pelo Qdrant Cloud.

# ──────────────────────────────────────────────────────────────
# Configurações do spaCy NER
# ──────────────────────────────────────────────────────────────
SPACY_MODEL_NAME=pt_core_news_md
# SPACY_CUSTOM_MODEL_PATH=/path/to/custom/model

# ──────────────────────────────────────────────────────────────
# Configurações de Normalização
# ──────────────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.65
TOP_K_SEARCH=1

# ──────────────────────────────────────────────────────────────
# Configurações do Ollama
# ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3

# ──────────────────────────────────────────────────────────────
# Configurações da Aplicação
# ──────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
