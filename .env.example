# API currently deployed on Vercel
APPLICATION_KEY=
GROQ_API_KEY=

# Optional encrypted HTTP contract
HTTP_CRYPTO_REQUIRED=false
HTTP_CRYPTO_SECRET=

# Qdrant Cloud (remote embeddings and vector search)
QDRANT_URL=https://seu-cluster.sua-regiao.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sintomas_embeddings_v2
QDRANT_CLOUD_INFERENCE=true
QDRANT_INFERENCE_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
SIMILARITY_THRESHOLD=0.92
TOP_K_SEARCH=1

# Supabase/PostgreSQL. Prefer Session Pooler in serverless environments.
POSTGRES_DSN=postgresql://usuario:senha@host:6543/postgres?sslmode=require
POSTGRES_POOL_SIZE=2
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=

DEBUG=false
LOG_LEVEL=INFO
